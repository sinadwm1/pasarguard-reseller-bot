# Telegram
BOT_TOKEN=replace_with_new_token
OWNER_TELEGRAM_IDS=replace_with_your_telegram_id
ADMIN_COMMAND=/owner
TELEGRAM_BUTTON_FEATURES=true
RECEIPT_GROUP_ID=

# Generate both values with: python scripts/generate_keys.py
ENCRYPTION_KEY=generate_with_scripts_generate_keys
CALLBACK_SIGNING_KEY=generate_with_scripts_generate_keys

# Infrastructure (Docker defaults)
DATABASE_URL=postgresql+asyncpg://pasarbot:REPLACE_DB_PASSWORD@postgres:5432/pasarbot
POSTGRES_DB=pasarbot
POSTGRES_USER=pasarbot
POSTGRES_PASSWORD=change_me
REDIS_URL=redis://redis:6379/0

# Runtime
ENVIRONMENT=production
LOG_LEVEL=INFO
SYNC_INTERVAL_SECONDS=300
QUOTA_ENFORCEMENT_MODE=suspend
EXPIRE_ALERT_DAYS=7,3,1
DEFAULT_CURRENCY=IRT
